{# fetches photos in "static/photos", sorted by date: "date" in "data/photos.yaml", then EXIF date taken, then file date #}
{% set files = site.static|filter(f => f.path matches '/^photos/')|sort((a, b) =>
  (site.data.photos[a.basename].date ?? a.exif.EXIF.DateTimeOriginal ?? a.date)|date('U')
  <=>
  (site.data.photos[b.basename].date ?? b.exif.EXIF.DateTimeOriginal ?? b.date)|date('U')
) %}
{# reverses sort if necessary #}
{% if site.photo.sort|default('asc') == 'desc' %}{%- set files = files|reverse %}{% endif %}
{% if files is not empty %}
{# uses the first photo for Open Graph image #}
{% set image = (files|first).path %}
{# creates first asset for preload (same "src" and "srcset" as the thumbnail) #}
{% set image_original = asset(image) %}
{% set image_width = site.photo.size.thumbnail|default(640) %}
{% set image_asset = image_original|resize(image_width)|webp %}
{% set image_srcset = image_original.width >= image_width * 2 ? url(image_asset) ~ ' 1x, ' ~ url(image_original|resize(image_width * 2)|webp) ~ ' 2x' : null %}
{% endif %}

{% extends 'page.html.twig' %}

    {%- block head -%}
    {{ parent() }}
    {%- if image_asset is defined %}
    <link rel="preload" as="image" href="{{ url(image_asset) }}"{% if image_srcset %} imagesrcset="{{ image_srcset }}"{% endif %}>
    {%- endif %}
    <style>{{ asset(site.photoswipe.core.css, {fallback: 'photoswipe/photoswipe.css'})|inline }}</style>
    <style>{{ asset(site.photoswipe.caption.css, {fallback: 'photoswipe/photoswipe-dynamic-caption-plugin.css'})|inline }}</style>
    {%- endblock head -%}

      {%- block css -%}
      {{ parent() }}
      div#gallery {
        display: flex;
        flex-wrap: wrap;
      }
      div#gallery::after {
        content: '';
        flex-grow: 999999999;
      }
      #gallery h1.title {
        position: fixed;
        z-index: 1;
        margin: 0.6rem;
        font-size: x-large;
        text-shadow: 0 0 .4rem rgba($background, .8), 0 1px 2px rgba($background, .9);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      #gallery h1.title a {
        text-decoration: none;
      }
      #gallery h1.title a:hover {
        -webkit-font-smoothing: auto;
        -moz-osx-font-smoothing: auto;
      }
      #gallery div.photo {
        flex-grow: 1;
        position: relative;
        margin: $margin;
        height: $height;
        background-color: $background;
      }
      #gallery img {
        object-fit: cover;
        height: $height;
        width: 100%;
        max-width: 100%;
        min-width: 100%;
        vertical-align: bottom;
        animation: fadeIn 500ms ease-in-out;
        @media (prefers-reduced-motion: reduce) {
          animation: none;
        }
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      #gallery img:hover {
        cursor: zoom-in;
        filter: brightness(115%);
        transition: filter .25s ease-out;
      }
      #gallery div.caption {
        position: absolute;
        bottom: 0px;
        left: 0px;
        padding: .2rem 0 .1rem .25rem;
        width: 100%;
        font-size: small;
        font-style: italic;
        line-height: normal;
        background-color: rgba($background, .6);
        opacity: .7;
        transition: opacity .5s ease-out, background-color .5s ease-out;
        /* touch screens: no hover, so the caption is always fully visible */
        @media (hover: none) {
          opacity: 1;
        }
      }
      #gallery div.photo:hover div.caption,
      #gallery div.photo:focus-within div.caption {
        background-color: rgba($background, .8);
        opacity: 1;
      }
      #gallery div.caption a {
        text-decoration: none;
      }
      #gallery div.caption span.author {
        font-style: normal;
      }
      .pswp {
        --pswp-bg: {{ site.photo.style.color.background }};
      }
      .pswp__dynamic-caption,
      .pswp__dynamic-caption a {
        color: {{ site.photo.style.color.text }};
      }
      {%- if site.photo.metadata|default(false) %}
      .pswp__dynamic-caption details {
        margin: 1rem 0 0;
        font-size: small;
      }
      .pswp__dynamic-caption summary {
        cursor: pointer;
        opacity: .6;
      }
      .pswp__dynamic-caption dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: .2rem .75rem;
        margin: .5rem 0 0;
        line-height: normal;
      }
      .pswp__dynamic-caption dt {
        opacity: .6;
      }
      .pswp__dynamic-caption dd {
        margin: 0;
      }
      {%- endif %}
      {%- endblock css -%}

      {%- block content ~%}
      <div id="gallery">
        <h1 class="title"><a href="{{ url(site.home) }}#" title="{{ site.description|default(site.title) }}">{{ site.title }}</a></h1>
        {%- set placeholder = site.photo.placeholder ?? false -%}
        {%- for file in files ~%}
          {#- photo details: "data/photos.yaml", else EXIF description and artist -#}
          {%- set photo_exif_data = {} -%}
          {%- if file.exif.IFD0.ImageDescription|default|trim %}{% set photo_exif_data = photo_exif_data|merge({title: file.exif.IFD0.ImageDescription|trim}) %}{% endif -%}
          {%- if file.exif.IFD0.Artist|default|trim %}{% set photo_exif_data = photo_exif_data|merge({author: {name: file.exif.IFD0.Artist|trim}}) %}{% endif -%}
          {%- set photo_data = photo_exif_data|merge(site.data.photos[file.basename] ?? {}) -%}
          {%- set original = asset(file.path) -%}
          {%- set thumbnail_width = site.photo.size.thumbnail|default(640) -%}
          {%- set photo = original|resize(thumbnail_width)|webp -%}
          {%- set photo_full = original|resize(site.photo.size.full|default(1920)) -%}
          {#- thumbnail: 2x version for high density screens -#}
          {%- set photo_srcset = original.width >= thumbnail_width * 2 ? url(photo) ~ ' 1x, ' ~ url(original|resize(thumbnail_width * 2)|webp) ~ ' 2x' : null -%}
          {#- lightbox: WebP versions (intermediate widths + full), picked by PhotoSwipe according to the displayed size -#}
          {%- set photo_full_srcset = [] -%}
          {%- for width in (site.photo.size.full_widths ?? [768, 1280])|filter(w => w < photo_full.width) -%}
            {%- set photo_full_srcset = photo_full_srcset|merge([url(original|resize(width)|webp) ~ ' ' ~ width ~ 'w']) -%}
          {%- endfor -%}
          {%- set photo_full_srcset = photo_full_srcset|merge([url(photo_full|webp) ~ ' ' ~ photo_full.width ~ 'w']) ~%}
          {%- if placeholder == 'image' ~%}
        <div class="photo" id="{{ file.basename }}" style="background-image:url({{ photo|lqip }});background-repeat:no-repeat;background-position:center;background-size:cover;">
          {%- elseif placeholder == 'color' ~%}
        <div class="photo" id="{{ file.basename }}" style="background-color:{{ photo|dominant_color }}">
          {%- else ~%}
        <div class="photo" id="{{ file.basename }}">
          {%- endif ~%}
          {%- set attributes = {alt: photo_data.alt|default(photo_data.title|default), decoding: 'async'} -%}
          {%- if photo_srcset %}{% set attributes = attributes|merge({srcset: photo_srcset}) %}{% endif -%}
          {%- if loop.index > 10 %}{% set attributes = attributes|merge({loading: 'lazy'}) %}{% endif -%}
          {%- set photo_name = photo_data.title|default(photo_data.alt|default) -%}
          {%- set label = photo_name ? 'View “%photo_name%” in full size'|trans({'%photo_name%': photo_name}) : 'Click to view this photo in full size'|trans -%}
          {%- set photo_download = site.photo.download|default('original') == 'full' ? url(photo_full) : url(file.path) ~%}
          <a href="{{ url(photo_full) }}" data-pswp-srcset="{{ photo_full_srcset|join(', ') }}" data-pswp-width="{{ photo_full.width }}" data-pswp-height="{{ photo_full.height }}" data-download="{{ photo_download }}" aria-label="{{ label }}">
            {{ html(photo, attributes) }}
          </a>
          {%- if photo_data.title is defined or photo_data.author.name is defined ~%}
          <div class="caption">
            {%- if photo_data.title is defined ~%}
            <em>{{ photo_data.title }}</em>
            {%- endif ~%}
            {%- if photo_data.title is defined and photo_data.author.name is defined %} &middot; {% endif ~%}
            {%- if photo_data.author.name is defined ~%}
            {%- set author -%}
              {%- if photo_data.author.url is defined -%}
                <a href="{{ photo_data.author.url }}" title="{% trans %}Author's page{% endtrans %}">{{ photo_data.author.name }}</a>
              {%- else -%}
                {{ photo_data.author.name }}
              {%- endif -%}
            {%- endset ~%}
            <span class="author">{%- trans %}Credit: %author%{% endtrans ~%}</span>
            {%- endif ~%}
          </div>
          {%- endif ~%}
          {%- if site.photo.metadata|default(false) ~%}
          {%- include 'partials/metadata.html.twig' with {file: file, photo_data: photo_data} only ~%}
          {%- endif ~%}
        </div>
        {%- endfor ~%}
      </div>
      <script type="module">
        {%- apply minify_js -%}
        import PhotoSwipeLightbox from '{{ asset(site.photoswipe.lightbox.js, {fallback: 'photoswipe/photoswipe-lightbox.esm.js'}) }}';
        import PhotoSwipeDynamicCaption from '{{ asset(site.photoswipe.caption.js, {fallback: 'photoswipe/photoswipe-dynamic-caption-plugin.esm.js'}) }}';
        const lightbox = new PhotoSwipeLightbox({
          gallery: '#gallery',
          children: '.photo',
          bgOpacity: 1.0,
          imageClickAction: 'close',
          tapAction: 'close',
          pswpModule: () => import('{{ asset(site.photoswipe.core.js, {fallback: 'photoswipe/photoswipe.esm.js'}) }}'),
          errorMsg: '{% trans -%}The photo cannot be loaded{%- endtrans %}',
        });
        // metadata: open/closed state, kept from one photo to another (and between visits)
        let metadataOpen = false;
        try { metadataOpen = localStorage.getItem('metadata-open') === '1'; } catch (e) {}
        document.addEventListener('toggle', (event) => {
          if (!event.target.matches?.('.pswp__dynamic-caption details')) return;
          metadataOpen = event.target.open;
          try { localStorage.setItem('metadata-open', metadataOpen ? '1' : '0'); } catch (e) {}
          // syncs captions of the preloaded slides
          document.querySelectorAll('.pswp__dynamic-caption details').forEach((details) => { details.open = metadataOpen; });
        }, true);
        const captionPlugin = new PhotoSwipeDynamicCaption(lightbox, {
          type: 'auto',
          captionContent: (slide) => {
            const photo = slide.data.element?.closest('.photo');
            if (!photo) return '';
            return ['.caption', '.metadata']
              .map((selector) => {
                const element = photo.querySelector(selector)?.cloneNode(true);
                element?.querySelector('details')?.toggleAttribute('open', metadataOpen);
                return element?.innerHTML ?? '';
              })
              .join('');
          },
        });
        lightbox.on('uiRegister', function() {
          lightbox.pswp.ui.registerElement({
            name: 'download-button',
            order: 8,
            isButton: true,
            tagName: 'a',
            html: {
              isCustomSVG: true,
              inner: '<path d="M20.5 14.3 17.1 18V10h-2.2v7.9l-3.4-3.6L10 16l6 6.1 6-6.1ZM23 23H9v2h14Z" id="pswp__icn-download"/>',
              outlineID: 'pswp__icn-download'
            },
            onInit: (el, pswp) => {
              el.setAttribute('download', '');
              el.setAttribute('target', '_blank');
              el.setAttribute('rel', 'noopener');
              pswp.on('change', () => {
                el.href = pswp.currSlide.data.element?.querySelector('[data-download]')?.dataset.download ?? pswp.currSlide.data.src;
              });
            }
          });
        });
        // deep link: the URL hash is the ID of the displayed photo
        const photos = [...document.querySelectorAll('#gallery .photo')];
        lightbox.on('change', () => {
          const id = lightbox.pswp.currSlide.data.element?.closest('.photo')?.id;
          if (id) history.replaceState(null, '', '#' + encodeURIComponent(id));
        });
        lightbox.on('close', () => {
          history.replaceState(null, '', location.pathname + location.search);
        });
        const openFromHash = () => {
          if (lightbox.pswp) return;
          const id = decodeURIComponent(location.hash.slice(1));
          const index = photos.findIndex((photo) => photo.id === id);
          if (index >= 0) lightbox.loadAndOpen(index);
        };
        window.addEventListener('hashchange', openFromHash);
        lightbox.init();
        openFromHash();
        {%- endapply -%}
      </script>
      {%- endblock content ~%}